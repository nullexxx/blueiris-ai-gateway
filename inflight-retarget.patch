+                err_x * prev_x < 0
+                and abs(err_x) >= self.cfg.inflight_reversal_error
+                and abs(prev_x) >= self.cfg.move_deadzone_x
+            )
+            reversed_y = (
+                err_y * prev_y < 0
+                and abs(err_y) >= self.cfg.inflight_reversal_error
+                and abs(prev_y) >= self.cfg.move_deadzone_y
+            )
+            if reversed_x or reversed_y:
