+    def _inflight_retarget_reason(
+        self,
+        err_x: float,
+        err_y: float,
+        bbox: Tuple[float, float, float, float],
+        frame_shape: Tuple[int, ...],
+        now: float,
+    ) -> Optional[str]:
+        if not self.cfg.inflight_retarget_enabled or self._ptz_operation != "move":
+            return None
