# Copy this file to .env and edit it for your environment.
# Never commit your real camera password.

TZ=America/New_York

# Host path mounted into /app/models
BI_AI_MODELS_PATH=/mnt/Docker_Data/bi-ai/models

# Gateway model settings
DEFAULT_MODEL=yolo11m
PRELOAD_MODELS=yolo11m
TRACKER_MODEL=yolo11m

# Optional crash-alert webhook
ALERT_WEBHOOK_URL=

# PTZ camera
TRACKER_CAMERA_IP=192.168.1.100
TRACKER_CAMERA_USER=admin
TRACKER_CAMERA_PASSWORD=change-me
